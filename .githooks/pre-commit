#!/usr/bin/env bash
# Pre-commit hook: blocks a commit that checks in a real (non-placeholder)
# FRIDA_OFFSET / OFFSET_* or TARGET value. See tools/check_placeholders.py
# for exactly what's checked and why.
#
# This directory isn't wired up automatically - git only looks in
# .git/hooks/, which isn't tracked. Install once per clone with:
#
#   git config core.hooksPath .githooks
#
# (Run from the repo root. This setting lives in your local, untracked
# .git/config, so each clone/contributor sets it once for themselves.)
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
python3 "$repo_root/tools/check_placeholders.py" --staged
